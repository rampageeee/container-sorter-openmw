 local function displayMessage(event)
+	-- OpenMW's built-in ShowMessage event uses `message`, whereas Potion Thrower
+	-- sends custom ShowMessage events with `text`. Ignore unrelated messages.
+	if type(event) ~= 'table' or type(event.text) ~= 'string' then
+		return
+	end
 	if visualSettings:get('DisplayMessages') then
 		ui.showMessage(event.text)
 	end
