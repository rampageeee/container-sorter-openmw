 local function menuActivated(e)
 
+    -- Defensive fallback for event ordering or MCM setup failures.
+    if not config then
+        local ok, configModule = pcall(require, "talkingMatters.config")
+        if ok and type(configModule) == "table" and type(configModule.loaded) == "table" then
+            config = configModule.loaded
+            log:warn("Talking Matters: recovered configuration during dialogue activation")
+        else
+            log:error("Talking Matters: dialogue skipped because configuration is unavailable: %s",
+                ok and "missing .loaded table" or tostring(configModule))
+            return
+        end
+    end
+    if not data or not data.npcData then
+        log:error("Talking Matters: dialogue skipped because player data has not initialized")
+        return
+    end
